# Copy to .env (development) and .env.test (integration tests) and fill in.
# Local Homebrew Postgres needs no password: postgresql://<macOS user>@localhost:5432/<database>
DATABASE_URL="postgresql://USER@localhost:5432/audiophile"

# Production (Vercel + Neon) sets these through the Vercel Marketplace integration.
# Migrations use the direct (unpooled) URL when it is set.
# DATABASE_URL_UNPOOLED=""

# Paystack TEST secret key (sk_test_…): Paystack dashboard → Settings → API Keys & Webhooks.
# Server-only; card payments are disabled without it, and live keys are refused.
PAYSTACK_SECRET_KEY=""
